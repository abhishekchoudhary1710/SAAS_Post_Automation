# Copy to .env for local runs. On GitHub these are repository secrets (Settings > Secrets and variables > Actions).

# --- Writing (free tier at https://aistudio.google.com/apikey, no card) ---
GEMINI_API_KEY=
# Optional: comma list, first that answers wins.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite

# --- Veo visual hook through Vertex AI (uses Application Default Credentials) ---
VEO_ENABLED=0
GOOGLE_CLOUD_PROJECT=video-generation-uniyal
GOOGLE_CLOUD_LOCATION=global
# VEO_MODEL=veo-3.1-lite-generate-001

# --- Facebook Page + Instagram (run: python setup/meta_setup.py ...) ---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
IG_USER_ID=
# META_GRAPH_VERSION=v23.0

# --- YouTube Shorts (run: python setup/youtube_setup.py client_secret.json) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# public | unlisted | private. Unaudited API projects are forced to private by YouTube anyway.
YT_PRIVACY=public

# --- LinkedIn company page, the jobs post only (see setup/linkedin_setup.py; the token lasts 60 days) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Written by: python setup/linkedin_setup.py --code "<address>" --save-to OWNER/REPO --env
LINKEDIN_ACCESS_TOKEN=
# The company page, urn:li:organization:<the number in the page's admin address>
LINKEDIN_AUTHOR_URN=
LINKEDIN_TOKEN_EXPIRES=
# LINKEDIN_API_VERSION=202606

# --- Buffer (free plan API): posts the jobs post on the LinkedIn page. Only the page is connected there.
BUFFER_API_KEY=
# BUFFER_CHANNEL=Interview Sarthi
# The key's expiry date, shown under it in Buffer > Settings > API
BUFFER_KEY_EXPIRES=

# --- Make.com scenario that posts the jobs post on the LinkedIn page (a secret: it can post) ---
LINKEDIN_WEBHOOK_URL=

# --- Telegram: without LinkedIn API access, the day's LinkedIn post comes here to post by hand ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Public URL host for Instagram media. Leave empty to use this repo's `media` branch (repo must be public).
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Behaviour ---
PLATFORMS=instagram,facebook,youtube,linkedin
DRY_RUN=0
