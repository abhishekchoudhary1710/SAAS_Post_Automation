[Unit]
Description=Social agent: start the %i LinkedIn Page post now
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# GitHub started the linkedin-growth.yml crons 4-6 hours late on 29-30 Sep 2026 (Wed 16:17 IST at 22:01,
# Wed 19:17 at 00:05), so late_start skipped all four and the Page got nothing. A workflow_dispatch starts
# within a minute. The crons stay as the backup; prepare() refuses a second post for the same date and slot.
ExecStart=/usr/bin/gh workflow run linkedin-growth.yml --repo abhishekchoudhary1710/SAAS_Post_Automation --ref main -f mode=publish -f slot=%i
